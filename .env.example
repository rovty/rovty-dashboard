# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). The anon/public key is
# safe to ship client-side — it's designed for this — do not put the
# service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
