{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovty-dashboard-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-07",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    "BILLING_MODE": "test",
    "BILLING_ORIGIN": "https://dashboard-staging.example.com",
    "ROVTY_ENV": "staging",
    "SUPABASE_URL": "https://your-staging-platform-ref.supabase.co",
    "SUPABASE_ANON_KEY": "your-staging-publishable-key",
    "WED_ORIGIN": "https://wed-staging.rovty.com",
  },
}
